{
  "name": "zetheta-payment-orchestrator",
  "version": "1.0.0",
  "description": "Zetheta Payment Orchestration Layer with Multi-Gateway Failover (Part A)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "worker:webhooks": "tsx src/workers/webhook.worker.ts",
    "worker:reconcile": "tsx src/workers/reconciliation.worker.ts",
    "db:start": "tsx scripts/start-db.ts",
    "db:stop": "tsx scripts/stop-db.ts",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "db:rollback": "tsx scripts/run-rollback.ts",
    "db:seed": "tsx scripts/run-seeds.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:partb": "vitest run tests/part-b/scenarios",
    "partb:bench": "tsx scripts/part-b-benchmarks.ts",
    "partb:integrity": "tsx scripts/part-b-integrity.ts",
    "partb:report": "tsx scripts/part-b-report.ts",
    "partb:all": "vitest run tests/part-b/scenarios && tsx scripts/part-b-benchmarks.ts && tsx scripts/part-b-integrity.ts && tsx scripts/part-b-report.ts",
    "test:all": "vitest run"

  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "embedded-postgres": "^18.6.0-beta.19",
    "express": "^4.21.2",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/uuid": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
